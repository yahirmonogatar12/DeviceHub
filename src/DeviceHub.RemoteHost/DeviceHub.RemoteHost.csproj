<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DeviceHub.RemoteHost</RootNamespace>
    <AssemblyName>DeviceHub.RemoteHost</AssemblyName>

    <!-- El icono del ejecutable, y de paso el de las ventanas: WPF usa el del
         .exe cuando la ventana no declara otro. -->
    <ApplicationIcon>..\..\assets\devicehub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Remote.Contracts\DeviceHub.Remote.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>


</Project>
