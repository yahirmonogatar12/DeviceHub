<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeviceHub.Dashboard</RootNamespace>

    <!-- WPF NO funciona con globalizacion invariante.
         Directory.Build.props la activa para todo el repositorio (ahorra tamaño
         en el servidor y el agente), pero el data binding de WPF llama a
         XmlLanguage.GetSpecificCulture() al renderizar y sin datos de cultura
         lanza "Cannot find non-neutral culture related to 'en-us'". El dashboard
         se abria y moria en el acto. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- El icono del ejecutable, y de paso el de las ventanas: WPF usa el del
         .exe cuando la ventana no declara otro. -->
    <ApplicationIcon>..\..\assets\devicehub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enlazado y no copiado: el png vive en assets, con el ico que sale de el.
         Dos copias del mismo logo acaban divergiendo. -->
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Contracts\DeviceHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>


  <!-- La barra de desplazamiento vive en src\Shared y la comparten el
       dashboard y el visor: es la misma plantilla y una sola copia. -->
  <ItemGroup>
    <Page Include="..\Shared\Barras.xaml">
      <Link>Styles\Barras.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>
