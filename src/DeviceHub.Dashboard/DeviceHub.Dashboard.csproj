<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeviceHub.Dashboard</RootNamespace>

    <!-- WPF NO funciona con globalizacion invariante.
         Directory.Build.props la activa para todo el repositorio (ahorra tamaño
         en el servidor y el agente), pero el data binding de WPF llama a
         XmlLanguage.GetSpecificCulture() al renderizar y sin datos de cultura
         lanza "Cannot find non-neutral culture related to 'en-us'". El dashboard
         se abria y moria en el acto. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Contracts\DeviceHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
