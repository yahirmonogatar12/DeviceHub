<Window x:Class="DeviceHub.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeviceHub.Dashboard.Views"
        Title="ILSAN DeviceHub" Height="800" Width="1400" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <views:LoginView Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= Barra superior ================= -->
            <Border Grid.Row="0" Background="{StaticResource Card}" Height="58"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False" Margin="16,0">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brand}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x25C8;" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DeviceHub" Style="{StaticResource H2}" Margin="10,0,26,0" />

                    <TextBox Width="300" VerticalAlignment="Center"
                             Tag="Buscar equipo, IP, area o linea..."
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtra por codigo, hostname, IP, area, linea o estado" />

                    <!-- Usuario y estado del servidor a la derecha -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SessionLabel}"
                               Style="{StaticResource Caption}" Margin="16,0,0,0" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource Online}"
                                 Visibility="{Binding ServerOk, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource Danger}"
                                 Visibility="{Binding ServerOk, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <TextBlock Text="Servidor" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Menu lateral ================= -->
                <Border Grid.Column="0" Background="{StaticResource Navy}">
                    <StackPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource NavItem}" Content="Equipos"
                                Command="{Binding NavigateCommand}" CommandParameter="machines"
                                Background="{Binding Page, Converter={StaticResource FondoNav}, ConverterParameter=machines}"
                                Foreground="{Binding Page, Converter={StaticResource TextoNav}, ConverterParameter=machines}" />
                        <Button Style="{StaticResource NavItem}" Content="Auditoria"
                                Command="{Binding NavigateCommand}" CommandParameter="audit"
                                Background="{Binding Page, Converter={StaticResource FondoNav}, ConverterParameter=audit}"
                                Foreground="{Binding Page, Converter={StaticResource TextoNav}, ConverterParameter=audit}" />
                    </StackPanel>
                </Border>

                <!-- ================= Contenido ================= -->
                <Grid Grid.Column="1">
                    <views:MachinesView Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}" />
                    <views:MachineDetailView Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}" />
                    <views:AuditView Visibility="{Binding ShowAudit, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- Solo aparece cuando hay algo que decir. -->
            <Border Grid.Row="2" Background="{StaticResource DangerSoft}" Padding="16,8"
                    BorderBrush="#FDA29B" BorderThickness="0,1,0,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Danger}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
