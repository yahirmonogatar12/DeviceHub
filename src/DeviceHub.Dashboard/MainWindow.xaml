<Window x:Class="DeviceHub.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeviceHub.Dashboard"
        Title="ILSAN DeviceHub" Height="740" Width="1320"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrush" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- ================= Login ================= -->
        <Border Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                Background="#F4F5F7">
            <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ILSAN DeviceHub" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
                <Label Content="Usuario" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                <Label Content="Password" Margin="0,10,0,0" />
                <PasswordBox x:Name="PasswordInput" Padding="6" />
                <Button Content="Entrar" Margin="0,18,0,0" Padding="8"
                        IsDefault="True"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- ================= Dashboard ================= -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <DockPanel Grid.Row="0" Margin="10,8" LastChildFill="False">
                <TextBlock Text="Equipos" FontSize="18" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBox Width="260" Padding="5" VerticalContentAlignment="Center"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filtra por codigo, hostname, IP, area, linea o estado" />
                <Button DockPanel.Dock="Right" Content="Generar codigo de enrolamiento" Padding="10,5"
                        Command="{Binding CreateEnrollmentCodeCommand}"
                        Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SessionLabel}" Margin="0,0,14,0" Foreground="#666" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <!-- Lista de maquinas -->
                <DataGrid Grid.Column="0" Margin="10,0,6,10"
                          ItemsSource="{Binding MachinesView}"
                          SelectedItem="{Binding SelectedMachine}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,7,0"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding MachineCode}" Width="150" />
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="140" />
                        <DataGridTextColumn Header="IP" Binding="{Binding CurrentIp}" Width="120" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding PrimaryMac}" Width="140" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding LoggedUser}" Width="150" />
                        <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="80" />
                        <DataGridTextColumn Header="Agente" Binding="{Binding AgentVersion}" Width="70" />
                        <DataGridTextColumn Header="Visto" Binding="{Binding LastSeenAgo}" Width="100" />
                        <DataGridTemplateColumn Header="" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="!" FontWeight="Bold" Foreground="#C0392B"
                                               ToolTip="Conflicto de identidad"
                                               Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Detalle -->
                <Border Grid.Column="1" Margin="0,0,10,10" BorderBrush="#DDD" BorderThickness="1" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedMachine}">
                        <StackPanel>
                            <TextBlock Text="{Binding MachineCode}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MachineId}" FontSize="10" Foreground="#999"
                                       TextWrapping="Wrap" Margin="0,2,0,10" />

                            <Border Background="#FDECEA" Padding="8" Margin="0,0,0,10"
                                    Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="CONFLICTO DE IDENTIDAD" FontWeight="Bold" Foreground="#C0392B" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8"
                                               Text="Otro agente reclama este machineId, o el hardware cambio. Lo resuelve un administrador." />
                                    <StackPanel Orientation="Horizontal"
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button Content="Aprobar hardware nuevo" Padding="6,3" Margin="0,0,6,0"
                                                Command="{Binding ApproveHardwareCommand}" />
                                        <Button Content="Emitir identidad nueva" Padding="6,3"
                                                Command="{Binding IssueNewIdentityCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Label Content="Ultimo visto (hora local)" />
                            <TextBlock Text="{Binding LastSeenLocal}" />
                            <Label Content="Sitio / area / linea / estacion" />
                            <TextBlock>
                                <Run Text="{Binding SiteCode, Mode=OneWay}" />
                                <Run Text=" / " /><Run Text="{Binding Area, Mode=OneWay}" />
                                <Run Text=" / " /><Run Text="{Binding Line, Mode=OneWay}" />
                                <Run Text=" / " /><Run Text="{Binding Station, Mode=OneWay}" />
                            </TextBlock>

                            <!-- Renombrar / mover -->
                            <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}"
                                        Margin="0,14,0,0">
                                <TextBlock Text="Renombrar / mover" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="El machineId no cambia y el historial se conserva. El agente adopta el nombre solo." />
                                <Label Content="Sitio" />
                                <TextBox Text="{Binding EditSiteCode}" Padding="4" />
                                <Label Content="Codigo" />
                                <TextBox Text="{Binding EditMachineCode}" Padding="4" />
                                <Label Content="Nombre visible" />
                                <TextBox Text="{Binding EditDisplayName}" Padding="4" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Label Content="Area" />
                                        <TextBox Text="{Binding EditArea}" Padding="4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="2,0">
                                        <Label Content="Linea" />
                                        <TextBox Text="{Binding EditLine}" Padding="4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <Label Content="Estacion" />
                                        <TextBox Text="{Binding EditStation}" Padding="4" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Guardar" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding MoveMachineCommand}" />
                            </StackPanel>

                            <!-- Historiales -->
                            <StackPanel DataContext="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="Historial de IP" FontWeight="SemiBold" Margin="0,18,0,4" />
                                <ItemsControl ItemsSource="{Binding IpHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,1">
                                                <Run Text="{Binding Ip, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding ValidFrom, Mode=OneWay}" Foreground="#888" />
                                                <Run Text=" -> " Foreground="#888" />
                                                <Run Text="{Binding ValidTo, Mode=OneWay}" Foreground="#888" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Historial de ubicacion" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <ItemsControl ItemsSource="{Binding PlacementHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,1" TextWrapping="Wrap">
                                                <Run Text="{Binding MachineCode, Mode=OneWay}" />
                                                <Run Text=" @ " Foreground="#888" />
                                                <Run Text="{Binding Area, Mode=OneWay}" />
                                                <Run Text="/" /><Run Text="{Binding Line, Mode=OneWay}" />
                                                <Run Text="/" /><Run Text="{Binding Station, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding ValidFrom, Mode=OneWay}" Foreground="#888" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#C0392B" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
