<!--
    Sistema visual de ILSAN DeviceHub.

    Un solo diccionario en vez de Colors/Buttons/DataGrid/Typography por separado:
    son 300 lineas en total y partirlas en cuatro archivos obliga a saltar entre
    ellos para cambiar un color. Cuando alguno crezca de verdad, ahi se parte.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DeviceHub.Dashboard">

    <!-- ================= Converters =================
         Aqui y no en cada vista: las cuatro los usan. -->
    <local:StatusToBrushConverter x:Key="StatusBrush" />
    <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:BytesToSizeConverter x:Key="Bytes" />

    <!-- ================= Paleta =================

         GRIS NEUTRO Y ROJO, la misma del visor, y no el azul de antes.

         Las dos mitades del producto se miran seguidas (se elige una PC en la
         lista y se entra a su escritorio) y hasta ahora cambiaban de mundo por
         el camino: azul marino sobre blanco aqui, gris casi negro alli. El
         motivo de aquel gris sigue valiendo igual de bien aqui: alrededor de una
         pantalla ajena va negro, y un color saturado tiñe lo que se mira.

         El rojo es de acento y solo aparece donde hay algo encendido: la seccion
         en la que estas, un conflicto, un boton peligroso. Un boton normal es
         gris, aunque sea el principal de la pantalla. -->
    <SolidColorBrush x:Key="Navy"        Color="#141414" />
    <SolidColorBrush x:Key="Primary"     Color="#E04A4A" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#33292A" />
    <SolidColorBrush x:Key="Accent"      Color="#3FB6C4" />
    <SolidColorBrush x:Key="Bg"          Color="#1B1B1B" />
    <SolidColorBrush x:Key="Card"        Color="#262626" />
    <SolidColorBrush x:Key="Ink"         Color="#E8E8E8" />
    <SolidColorBrush x:Key="Muted"       Color="#9A9A9A" />
    <SolidColorBrush x:Key="Faint"       Color="#6E6E6E" />
    <SolidColorBrush x:Key="Line"        Color="#3A3A3A" />

    <!-- Los estados suben de luminosidad: sobre blanco un verde oscuro se lee
         solo, sobre #1B1B1B desaparece. -->
    <SolidColorBrush x:Key="Online"      Color="#3FBF7F" />
    <SolidColorBrush x:Key="Warn"        Color="#E8A13A" />
    <SolidColorBrush x:Key="Offline"     Color="#7A7A7A" />
    <SolidColorBrush x:Key="Danger"      Color="#E5544B" />
    <SolidColorBrush x:Key="DangerSoft"  Color="#3A2422" />

    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2D2D2D" Offset="0" />
        <GradientStop Color="#E04A4A" Offset="1" />
    </LinearGradientBrush>

    <!-- ================= Tipografia ================= -->
    <!-- Sin Foreground a proposito: un Setter implicito gana al valor heredado,
         y entonces el texto del menu lateral se pintaba en gris oscuro sobre el
         azul marino, ilegible. El color base lo pone la ventana (TextElement.
         Foreground se hereda) y quien necesita otro lo declara. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Todos con BasedOn: un estilo con nombre NO hereda del implicito, y sin
         esto perdian VerticalAlignment y salian descuadrados en la barra. -->
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,10,0,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- Label heredado: queda por compatibilidad, alineado a la paleta. -->
    <Style TargetType="Label">
        <Setter Property="Padding" Value="0,4,6,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- ================= Tarjeta ================= -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ================= Botones ================= -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El principal es GRIS, no rojo. En esta paleta el rojo significa
         "encendido" o "cuidado", y el boton de uso mas comun de la pantalla no
         es ninguna de las dos cosas: se distingue por ser el unico solido. -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="#4A4A4A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}" />

    <!-- ================= Navegacion lateral =================
         Boton normal: el resaltado sale de comparar Page con el parametro, no de
         un estado marcado. Ver MatchBrushConverter. -->
    <local:MatchBrushConverter x:Key="FondoNav" Igual="{StaticResource Primary}" Distinto="Transparent" />
    <local:MatchBrushConverter x:Key="TextoNav" Igual="White" Distinto="{StaticResource Muted}" />

    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="12,9">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Background" Value="Transparent" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fondo" Property="Background" Value="#16305F" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tarjeta de KPI =================
         La tarjeta ES el filtro por estado: pulsar "Offline" deja solo las
         offline y volver a pulsarla las devuelve todas. -->
    <local:MatchBrushConverter x:Key="FondoKpi" Igual="{StaticResource PrimarySoft}" Distinto="{StaticResource Card}" />
    <local:MatchBrushConverter x:Key="BordeKpi" Igual="{StaticResource Primary}" Distinto="{StaticResource Line}" />

    <!-- ================= Ficha de filtro =================
         Sustituye a las tarjetas de KPI. Cinco tarjetas de 118 px ocupaban una
         franja entera de la pantalla para decir cinco numeros que caben en una
         linea, y encima empujaban hacia abajo la tabla, que es lo que se viene a
         mirar. La ficha hace lo mismo: ensena el numero y filtra al pulsarla. -->
    <Style x:Key="FichaFiltro" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="11,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El punto de color de cada ficha. Sin el, cinco fichas grises seguidas
         obligan a leerlas todas para encontrar la de Online. -->
    <Style x:Key="PuntoEstado" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CuentaFicha" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <!-- ================= Desplegable de filtro ================= -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Boton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{StaticResource Card}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="6" Padding="9,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="&#x25BE;" FontSize="10"
                                                       Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" />
                        </ToggleButton>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#2F2F2F" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarySoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Miniatura con curva ================= -->
    <Style x:Key="Miniatura" TargetType="Border">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="MiniNumero" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,1,0,4" />
    </Style>

    <!-- La curva se dibuja en un rectangulo de 100x30 que arma el ViewModel, y
         se estira a lo ancho de la miniatura. Sin Stretch habria que saber aqui
         cuanto mide, y mide lo que le deje la columna. -->
    <Style x:Key="Curva" TargetType="Polyline">
        <Setter Property="Stroke" Value="{StaticResource Accent}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Stretch" Value="Fill" />
    </Style>

    <Style x:Key="KpiNumero" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- ================= Entradas ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Texto de ayuda: WPF no tiene placeholder. Se toma de
                                 Tag para no inventar una propiedad adjunta que solo
                                 llevaria una cadena. Uso: <TextBox Tag="Buscar..." /> -->
                            <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}"
                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Fondo" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= DataGrid ================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2F2F2F" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Pestanas ================= -->
    <!-- EL COLOR DEL TEXTO, EXPLICITO. Sin esto, lo de dentro de una pestaña
         sale con el negro que trae el sistema: el TabItem tiene su propio
         Foreground por ser un Control, y el contenido lo hereda de el. Sobre
         fondo claro no se notaba porque el negro del sistema y la tinta de la
         paleta eran casi el mismo color; sobre #1B1B1B, los valores de la ficha
         del equipo se volvieron ilegibles, mientras las etiquetas (que si llevan
         color propio) se quedaron leyendose. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- El color y el grosor van SOBRE LA CABECERA, nunca sobre el TabItem: el
         contenido de la pestana hereda de el por el arbol logico, y ponerle el
         azul de "seleccionada" pintaba de azul toda la ficha del equipo. -->
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />

        <!-- Este color es el del CONTENIDO de la pestaña, no el de su cabecera:
             la cabecera se pinta dentro de la plantilla. Ver arriba. -->
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Fondo" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="14,9" TextElement.Foreground="{StaticResource Muted}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="TextElement.Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter TargetName="Fondo" Property="TextElement.Foreground" Value="{StaticResource Primary}" />
                            <Setter TargetName="Fondo" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Menu de acciones ================= -->
    <Style x:Key="MenuAcciones" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="MenuAccionesRaiz" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Fondo" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Height="34" Padding="14,0">
                        <Grid>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            <Popup IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                   HorizontalOffset="-14" VerticalOffset="4">
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="190">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuAccion" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="5" Padding="12,8">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Bg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuAccionPeligro" TargetType="MenuItem" BasedOn="{StaticResource MenuAccion}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <!-- ================= Linea de auditoria =================
         Compartida por la pestana de un equipo y la pagina de toda la planta:
         es el mismo registro, no tiene por que verse distinto. -->
    <DataTemplate x:Key="LineaAuditoria">
        <Border x:Name="Fila" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding When}" Style="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Who}" FontSize="12"
                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Machine}" FontSize="12"
                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="4" Text="{Binding Details}" FontSize="12"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <!-- Un intento denegado es la linea que importa de una auditoria. -->
            <DataTrigger Binding="{Binding IsDenied}" Value="True">
                <Setter TargetName="Fila" Property="Background" Value="{StaticResource DangerSoft}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Linea de historial =================
         Sirve para IP y para ubicacion: las dos son "que / donde / desde cuando
         hasta cuando". Sin "hasta" es el valor vigente. -->
    <DataTemplate x:Key="LineaHistorial">
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Que}" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Donde}" FontSize="12"
                           Foreground="{StaticResource Muted}" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Desde}" Style="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}" />

                <TextBlock Grid.Column="3" Text="{Binding Hasta}" Style="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}"
                           Visibility="{Binding EsVigente, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <Border Grid.Column="3" Background="#E7F8F0" BorderBrush="{StaticResource Online}"
                        BorderThickness="1" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                        Visibility="{Binding EsVigente, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="vigente" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Online}" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ================= Barra de desplazamiento ================= -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

</ResourceDictionary>
