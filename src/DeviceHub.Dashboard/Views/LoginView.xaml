<UserControl x:Class="DeviceHub.Dashboard.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource Bg}">
        <Border Style="{StaticResource CardPanel}" Padding="34,30" Width="360"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource Brand}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#x25C8;" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="DeviceHub" Style="{StaticResource H1}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Centro de control ILSAN" Style="{StaticResource Caption}"
                           Margin="0,2,0,0" HorizontalAlignment="Center" />

                <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" Margin="0,26,0,3" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" />

                <Button Content="Iniciar sesion" Style="{StaticResource BtnPrimary}"
                        Height="38" Margin="0,22,0,0" IsDefault="True"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}" />

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Danger}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
