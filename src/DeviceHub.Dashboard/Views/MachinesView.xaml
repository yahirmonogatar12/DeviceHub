<UserControl x:Class="DeviceHub.Dashboard.Views.MachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- AL LADO, no encima. Un modal centrado tapa justo lo que se estaba
             mirando, y al cerrarlo hay que volver a buscar la fila. Asi la tabla
             sigue ahi y se salta de una PC a otra sin cerrar nada. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Titulo + accion de administrador -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Equipos" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Caption}" Margin="10,6,0,0" VerticalAlignment="Bottom">
                <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" registrados" />
            </TextBlock>

            <Button DockPanel.Dock="Right" Content="Generar codigo de enrolamiento"
                    Style="{StaticResource BtnGhost}"
                    Command="{Binding CreateEnrollmentCodeCommand}"
                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}" />

            <!-- A TODOS DE UNA. El agente mira el recurso cada seis horas por su
                 cuenta; esto es para cuando se acaba de publicar algo. Pulsarlo
                 equipo por equipo con veinte PCs es una tarde. -->
            <Button DockPanel.Dock="Right" Content="Actualizar todos"
                    Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    ToolTip="Pide a todos los equipos EN LINEA que busquen actualizacion ahora"
                    Command="{Binding UpdateAllCommand}"
                    Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <!-- Filtros. Las fichas de estado SON el filtro: pulsar una deja solo
             esas y volver a pulsarla las devuelve todas. Area y linea van al
             lado porque se combinan con ellas, no las sustituyen. -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter=""
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Todos" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter="ONLINE"
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}, ConverterParameter=ONLINE}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}, ConverterParameter=ONLINE}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" Fill="{StaticResource Online}" />
                    <TextBlock Text="Online" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding OnlineCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter="UNREACHABLE"
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}, ConverterParameter=UNREACHABLE}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}, ConverterParameter=UNREACHABLE}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" Fill="{StaticResource Warn}" />
                    <TextBlock Text="Sin respuesta" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding UnreachableCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter="OFFLINE"
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}, ConverterParameter=OFFLINE}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}, ConverterParameter=OFFLINE}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" Fill="{StaticResource Offline}" />
                    <TextBlock Text="Offline" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding OfflineCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter="CONFLICT"
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}, ConverterParameter=CONFLICT}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}, ConverterParameter=CONFLICT}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" Fill="{StaticResource Danger}" />
                    <TextBlock Text="Conflicto" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding ConflictCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource FichaFiltro}"
                    Command="{Binding FilterByStatusCommand}" CommandParameter="RETIRED"
                    Background="{Binding StatusFilter, Converter={StaticResource FondoKpi}, ConverterParameter=RETIRED}"
                    BorderBrush="{Binding StatusFilter, Converter={StaticResource BordeKpi}, ConverterParameter=RETIRED}"
                    ToolTip="Equipos dados de baja: conservan su historial y no pueden conectarse">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="De baja" Foreground="{StaticResource Muted}" />
                    <TextBlock Style="{StaticResource CuentaFicha}">
                        <Run Text="(" /><Run Text="{Binding RetiredCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Button>

            <Border Width="1" Background="{StaticResource Line}" Margin="6,3,14,3" />

            <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding AreaFilter}"
                      ToolTip="Area" />
            <ComboBox ItemsSource="{Binding Lineas}" SelectedItem="{Binding LineFilter}"
                      ToolTip="Linea" />
        </WrapPanel>

        <!-- Listado -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True">
            <Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,40,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                           Visibility="{Binding TotalCount, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                           Text="Ningun equipo registrado todavia.&#x0a;Genera un codigo de enrolamiento e instala el agente en una PC." />

                <DataGrid ItemsSource="{Binding MachinesView}"
                          SelectedItem="{Binding SelectedMachine}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Estado" Width="128">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,3"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Codigo y hostname en dos lineas: ahorra una columna entera -->
                        <DataGridTemplateColumn Header="Equipo" Width="270">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MachineCode}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Hostname}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP" Binding="{Binding CurrentIp}" Width="130" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding LoggedUser}" Width="160" />
                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="70" />
                        <DataGridTextColumn Header="RAM" Binding="{Binding Memory}" Width="70" />
                        <DataGridTextColumn Header="Ultimo visto" Binding="{Binding LastSeenAgo}" Width="110" />

                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="&#x26A0;" FontSize="14" Foreground="{StaticResource Danger}"
                                               ToolTip="Conflicto de identidad"
                                               Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Relleno: sin el, "*" se lo lleva la columna del nombre y
                             los datos quedan desperdigados en pantallas anchas. -->
                        <DataGridTemplateColumn Width="*" CanUserSort="False" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= Panel rapido ================= -->
        <Border Grid.Row="2" Grid.Column="1" Width="330" Margin="14,0,0,0"
                Style="{StaticResource CardPanel}" Padding="0"
                DataContext="{Binding SelectedMachine}"
                Visibility="{Binding DataContext.ShowQuickPanel,
                             RelativeSource={RelativeSource AncestorType=UserControl},
                             Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">

                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="{Binding MachineCode}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Hostname}" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource BtnLink}"
                                VerticalAlignment="Top" Height="22" ToolTip="Cerrar"
                                Command="{Binding DataContext.CloseQuickPanelCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Style="{StaticResource PuntoEstado}"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding LastSeenAgo}" Style="{StaticResource CuentaFicha}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Conectar es a lo que se viene aqui el 90 % de las veces,
                         asi que es el unico boton solido. -->
                    <Button Content="Conectar" Style="{StaticResource BtnPrimary}"
                            Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding Retired, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            Command="{Binding DataContext.RemoteControlCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="devicehub" />

                    <Button Content="Ver detalles y mas acciones" Style="{StaticResource BtnGhost}"
                            Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.OpenDetailCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <!-- Dar de baja va con los datos delante y no arriba con
                         Conectar: no es una accion de uso diario, y un boton
                         peligroso pegado al que se usa todo el rato acaba
                         pulsandose por inercia. -->
                    <Button Content="Dar de baja" Style="{StaticResource BtnDanger}"
                            Margin="0,16,0,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding DataContext.PuedeDarDeBaja,
                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                         Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.RetireMachineCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <Border Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,16,0,0"
                            Visibility="{Binding Retired, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}">
                                <Run Text="Dada de baja por" /><Run Text=" " /><Run Text="{Binding RetiredBy, Mode=OneWay}" /><Run
                                    Text=". No puede conectarse; su historial se conserva." />
                            </TextBlock>

                            <Button Content="Reactivar" Style="{StaticResource BtnGhost}"
                                    Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    Visibility="{Binding DataContext.IsAdministrator,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RestoreMachineCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Conflicto de identidad" FontSize="12"
                                   Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{StaticResource Line}" Height="1" Margin="0,16" />

                    <TextBlock Text="Informacion general" Style="{StaticResource Caption}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentIp}" FontSize="12" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LoggedUser}" FontSize="12" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Area / Linea" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,6,0,0">
                            <Run Text="{Binding Area, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Line, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Agente" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding AgentVersion}" FontSize="12" />

                            <!-- Al lado de la version y no en un menu: el sitio
                                 donde se ve que una PC esta atrasada es el sitio
                                 donde se quiere ponerla al dia. -->
                            <Button Content="actualizar" Style="{StaticResource BtnLink}"
                                    FontSize="11" Height="18" Margin="8,0,0,0" Padding="0"
                                    ToolTip="Mirar el recurso de actualizaciones ahora, sin esperar las 6 h"
                                    Visibility="{Binding DataContext.IsAdministrator,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.CheckUpdateCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Uptime" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Uptime}" FontSize="12" Margin="0,6,0,0" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ultimo visto" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastSeenLocal}" FontSize="12" Margin="0,6,0,0" />
                    </Grid>

                    <Border Background="{StaticResource Line}" Height="1" Margin="0,16" />

                    <TextBlock Text="Estadisticas rapidas" Style="{StaticResource Caption}" />

                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Border Style="{StaticResource Miniatura}">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Cpu}" Style="{StaticResource MiniNumero}" />
                                <Polyline Points="{Binding CpuCurva}" Style="{StaticResource Curva}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Miniatura}">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Memory}" Style="{StaticResource MiniNumero}" />
                                <Polyline Points="{Binding RamCurva}" Style="{StaticResource Curva}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Miniatura}">
                            <StackPanel>
                                <TextBlock Text="Disco" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding DiskFree}" Style="{StaticResource MiniNumero}" />
                                <Polyline Points="{Binding DiscoCurva}" Style="{StaticResource Curva}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
