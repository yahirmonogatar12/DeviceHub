<Window x:Class="DeviceHub.Dashboard.Views.ConfirmarBajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dar de baja" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Ink}">

    <!-- La advertencia y la contrasena en el MISMO dialogo, no en dos seguidos.
         Un "seguro?" al que se dice que si por inercia y despues una contrasena
         no protege mas que pedir la contrasena una vez, con lo que va a pasar
         escrito al lado. -->
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Titulo" Style="{StaticResource H2}" Text="Dar de baja" />

        <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Danger}"
                           Text="Se le quita el token: esa PC no vuelve a conectarse y sale de la lista." />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                           Foreground="{StaticResource Muted}"
                           Text="El historial se conserva entero y se puede reactivar, pero para que vuelva a conectarse habra que reenrolarla." />
            </StackPanel>
        </Border>

        <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
        <TextBlock x:Name="Quien" Style="{StaticResource Caption}" Margin="0,0,0,6" />

        <PasswordBox x:Name="Clave" KeyDown="TeclaEnLaClave" />

        <TextBlock x:Name="Error" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancelar" />
            <Button x:Name="BotonConfirmar" Content="Dar de baja" Style="{StaticResource BtnDanger}"
                    Click="Confirmar" />
        </StackPanel>
    </StackPanel>
</Window>
