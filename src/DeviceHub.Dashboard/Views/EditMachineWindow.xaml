<Window x:Class="DeviceHub.Dashboard.Views.EditMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar equipo" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Ink}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Renombrar o mover" Style="{StaticResource H2}" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="El machineId no cambia y el historial se conserva. El agente adopta el nombre nuevo sin que nadie toque la PC." />

        <TextBlock Text="Sitio" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding EditSiteCode}" />

        <TextBlock Text="Codigo" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding EditMachineCode}" />

        <TextBlock Text="Nombre visible" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding EditDisplayName}" />

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Area" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditArea}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0">
                <TextBlock Text="Linea" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditLine}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="Estacion" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EditStation}" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Guardar" Style="{StaticResource BtnPrimary}"
                    IsDefault="True" Click="Guardar" />
        </StackPanel>
    </StackPanel>
</Window>
