<Window x:Class="DeviceHub.Dashboard.Views.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceHub - Terminal" Height="620" Width="960"
        Background="#0B1F55" WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14">

        <Border DockPanel.Dock="Top" Background="#08163D" Padding="12,8" CornerRadius="4"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="Cabecera" FontFamily="Consolas" FontSize="13"
                           Foreground="#E8EEFB" Text="Abriendo sesion..." />

                <!-- La identidad NO es decorativa: el agente es un servicio
                     LocalSystem, asi que todo corre como SYSTEM. Quien no lo sepa
                     interpreta mal cualquier comando que toque el perfil del
                     usuario, las unidades de red o HKCU. -->
                <TextBlock x:Name="Identidad" FontFamily="Consolas" FontSize="12"
                           Foreground="#F2B24C" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#08163D" Padding="10,6" CornerRadius="4"
                Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="Prompt" DockPanel.Dock="Left" FontFamily="Consolas" FontSize="13"
                           Foreground="#7FD1A8" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="&gt;" />

                <TextBox x:Name="Entrada" FontFamily="Consolas" FontSize="13"
                         Background="Transparent" Foreground="#E8EEFB" BorderThickness="0"
                         CaretBrush="#E8EEFB" KeyDown="TeclaEnLaEntrada" />
            </DockPanel>
        </Border>

        <TextBox x:Name="Salida" FontFamily="Consolas" FontSize="12"
                 Background="#061029" Foreground="#C8D6EE" BorderThickness="0" Padding="10"
                 IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

    </DockPanel>
</Window>
