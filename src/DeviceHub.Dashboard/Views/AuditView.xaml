<UserControl x:Class="DeviceHub.Dashboard.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Auditoria" Style="{StaticResource H1}" />
            <TextBlock Text="Quien hizo que, en toda la planta" Style="{StaticResource Caption}"
                       Margin="10,6,0,0" VerticalAlignment="Bottom" />
            <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource BtnGhost}"
                    Command="{Binding RefreshGlobalAuditCommand}" />
            <TextBox DockPanel.Dock="Right" Width="320" Margin="0,0,8,0" VerticalAlignment="Center"
                     Tag="Buscar accion, usuario, equipo o detalle..."
                     Text="{Binding AuditFilter, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <TextBlock Text="Sin eventos registrados." Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                           Visibility="{Binding Audit.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AuditFiltered}"
                                  ItemTemplate="{StaticResource LineaAuditoria}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
