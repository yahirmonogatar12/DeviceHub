<Window x:Class="DeviceHub.RemoteViewer.GestorArchivos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceHub - Archivos" Height="700" Width="1240"
        Background="#1B1B1B" WindowStartupLocation="CenterOwner"
        AllowDrop="True" DragOver="ArrastrandoEncima" Drop="Soltados">

    <!-- DOS PANELES, como AnyDesk: este equipo a la izquierda y la PC remota a
         la derecha, cada uno con su ruta y su historial.

         Y es una VENTANA, no un panel dentro de la sesion. El lateral de 360 px
         que habia antes no da para dos listas con columnas, y ensancharlo
         comeria el video; ponerlo encima tampoco se puede, porque el video es
         una ventana Win32 y nada de XAML se dibuja sobre ella. -->

    <Window.Resources>
        <SolidColorBrush x:Key="Barra"      Color="#2D2D2D" />
        <SolidColorBrush x:Key="Panel"      Color="#232323" />
        <SolidColorBrush x:Key="Hueco"      Color="#181818" />
        <SolidColorBrush x:Key="Linea"      Color="#3C3C3C" />
        <SolidColorBrush x:Key="Realce"     Color="#3A3A3A" />
        <SolidColorBrush x:Key="Letra"      Color="#DCDCDC" />
        <SolidColorBrush x:Key="LetraTenue" Color="#8C8C8C" />
        <SolidColorBrush x:Key="Acento"     Color="#EF443B" />

        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Letra}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Realce}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A6A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Accion" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Barra}" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Hueco}" />
            <Setter Property="Foreground" Value="{StaticResource Letra}" />
            <Setter Property="CaretBrush" Value="{StaticResource Letra}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Barra}" />
            <Setter Property="Foreground" Value="{StaticResource LetraTenue}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Letra}" />
            <Setter Property="Padding" Value="2,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Acento}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Abajo: que esta pasando ahora mismo, y el portapapeles de archivos
             de la Fase 25. UNA barra para los dos paneles, porque las
             transferencias van en serie: nunca hay dos cosas que contar. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,0" Padding="10,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BotonTraer" Content="Traer copiado" Click="Traer" IsEnabled="False"
                            ToolTip="Los archivos que copiaron en la PC remota" />
                    <Button Content="Llevar copiado" Click="Llevar"
                            ToolTip="Lo que tengas copiado aqui, al portapapeles de alla" />
                </StackPanel>

                <StackPanel>
                    <ProgressBar x:Name="Progreso" Height="5" Margin="0,0,12,5"
                                 Background="{StaticResource Hueco}" Foreground="{StaticResource Acento}"
                                 BorderThickness="0" />
                    <TextBlock x:Name="Estado" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource LetraTenue}" TextTrimming="CharacterEllipsis"
                               Text="" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================== ESTE EQUIPO ========================== -->
            <DockPanel Grid.Column="0" Margin="10,10,5,10">

                <Border DockPanel.Dock="Top" Background="{StaticResource Barra}" Padding="8,6"
                        CornerRadius="3,3,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Accion}"
                                Content="Cargar  &#x2192;" Click="Cargar"
                                ToolTip="Subir lo seleccionado a la carpeta abierta de la PC remota" />

                        <TextBlock Text="Este equipo" Foreground="{StaticResource Letra}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="6,5">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="&#x2191;" Width="26" Click="SubirLocal"
                                ToolTip="Carpeta superior" />
                        <Button DockPanel.Dock="Left" Content="&#x2302;" Width="26" Click="CasaLocal"
                                ToolTip="Unidades" />
                        <Button DockPanel.Dock="Left" Content="&#x21BB;" Width="26" Click="RefrescarLocal"
                                ToolTip="Actualizar" />

                        <TextBox x:Name="RutaLocal" Margin="6,0,0,0" KeyDown="RutaLocalEscrita" />
                    </DockPanel>
                </Border>

                <ListView x:Name="Local" Background="{StaticResource Hueco}" BorderThickness="0"
                          FontFamily="Consolas" FontSize="12" SelectionMode="Extended"
                          MouseDoubleClick="AbrirLocal">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nombre" Width="300"
                                            DisplayMemberBinding="{Binding Etiqueta}" />
                            <GridViewColumn Header="Tamano" Width="90"
                                            DisplayMemberBinding="{Binding Peso}" />
                            <GridViewColumn Header="Modificado" Width="130"
                                            DisplayMemberBinding="{Binding Cuando}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource Linea}" />

            <!-- ========================= EQUIPO REMOTO ========================= -->
            <DockPanel Grid.Column="2" Margin="5,10,10,10">

                <Border DockPanel.Dock="Top" Background="{StaticResource Barra}" Padding="8,6"
                        CornerRadius="3,3,0,0">
                    <DockPanel>
                        <TextBlock x:Name="TituloRemoto" DockPanel.Dock="Right"
                                   Foreground="{StaticResource Letra}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="Equipo remoto" />

                        <Button HorizontalAlignment="Left" Style="{StaticResource Accion}"
                                Content="&#x2190;  Descargar" Click="Descargar"
                                ToolTip="Bajar lo seleccionado a la carpeta abierta de este equipo" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="6,5">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="&#x2191;" Width="26" Click="SubirRemoto"
                                ToolTip="Carpeta superior" />
                        <Button DockPanel.Dock="Left" Content="&#x2302;" Width="26" Click="CasaRemota"
                                ToolTip="Unidades" />
                        <Button DockPanel.Dock="Left" Content="&#x21BB;" Width="26" Click="RefrescarRemoto"
                                ToolTip="Actualizar" />

                        <TextBox x:Name="RutaRemota" Margin="6,0,0,0" KeyDown="RutaRemotaEscrita" />
                    </DockPanel>
                </Border>

                <ListView x:Name="Remoto" Background="{StaticResource Hueco}" BorderThickness="0"
                          FontFamily="Consolas" FontSize="12" SelectionMode="Extended"
                          MouseDoubleClick="AbrirRemoto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nombre" Width="300"
                                            DisplayMemberBinding="{Binding Etiqueta}" />
                            <GridViewColumn Header="Tamano" Width="90"
                                            DisplayMemberBinding="{Binding Peso}" />
                            <GridViewColumn Header="Modificado" Width="130"
                                            DisplayMemberBinding="{Binding Cuando}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
