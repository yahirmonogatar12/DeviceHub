<Window x:Class="DeviceHub.RemoteViewer.ConsolaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceHub - Control remoto" Height="700" Width="1180"
        Background="#1B1B1B" WindowStartupLocation="CenterScreen">

    <!-- La ventana que sostiene las sesiones, y NADA MAS.
         Todo lo que se ve de una sesion (barra, menus, video, panel de archivos,
         estadisticas) vive en SesionRemota. Aqui solo estan las pestañas y quien
         esta delante. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Barra"     Color="#2D2D2D" />
        <SolidColorBrush x:Key="Hueco"     Color="#181818" />
        <SolidColorBrush x:Key="Linea"     Color="#3A3A3A" />
        <SolidColorBrush x:Key="Letra"     Color="#E8E8E8" />
        <SolidColorBrush x:Key="LetraTenue" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Acento"    Color="#E04A4A" />
    </Window.Resources>

    <DockPanel>

        <!-- La franja de pestañas. Se esconde con una sola sesion: con una PC
             abierta no hay nada que elegir, y la franja solo quitaria alto al
             escritorio remoto. -->
        <Border x:Name="FranjaPestanas" DockPanel.Dock="Top"
                Background="{StaticResource Hueco}"
                BorderBrush="{StaticResource Linea}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Pestanas" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- Todas las sesiones viven aqui A LA VEZ, y solo una esta visible.

             NO es un TabControl: el de WPF solo construye el arbol de la
             pestaña elegida, asi que al cambiar destruiria el HwndHost del video,
             y con el la cadena de intercambio y el descodificador. Cada cambio de
             pestaña costaria una reconexion entera. -->
        <Grid x:Name="Contenido" Background="{StaticResource Hueco}">
            <TextBlock x:Name="SinSesiones" Foreground="{StaticResource LetraTenue}"
                       FontFamily="Segoe UI" FontSize="13" TextAlignment="Center" LineHeight="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Sin sesiones.&#x0a;&#x0a;Este visor lo abre el dashboard al pulsar CONTROLAR PC." />
        </Grid>
    </DockPanel>
</Window>
