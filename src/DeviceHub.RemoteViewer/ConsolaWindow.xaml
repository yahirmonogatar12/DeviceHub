<Window x:Class="DeviceHub.RemoteViewer.ConsolaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:DeviceHub.RemoteViewer.Render"
        Title="DeviceHub - Control remoto" Height="700" Width="1180"
        Background="#1B1B1B" WindowStartupLocation="CenterScreen">

    <!-- La ventana que sostiene las sesiones, y NADA MAS.
         Todo lo que se ve de una sesion (barra, menus, video, panel de archivos,
         estadisticas) vive en SesionRemota. Aqui solo estan las pestañas, el
         mosaico y quien esta delante. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Barra"     Color="#2D2D2D" />
        <SolidColorBrush x:Key="Hueco"     Color="#181818" />
        <SolidColorBrush x:Key="Linea"     Color="#3A3A3A" />
        <SolidColorBrush x:Key="Letra"     Color="#E8E8E8" />
        <SolidColorBrush x:Key="LetraTenue" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Acento"    Color="#E04A4A" />

        <Style TargetType="Button" x:Key="BotonBarra">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LetraTenue}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Background" Value="#2D2D2D" />
                                <Setter Property="Foreground" Value="{StaticResource Letra}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- La franja. Pestañas a la izquierda, mosaico y pantalla completa a la
             derecha. Se queda visible tambien en pantalla completa: son 28 px de
             1080, y es por donde se vuelve. -->
        <Border x:Name="FranjaPestanas" DockPanel.Dock="Top"
                Background="{StaticResource Hueco}"
                BorderBrush="{StaticResource Linea}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BotonMosaico" Style="{StaticResource BotonBarra}"
                            Content="Mosaico" Click="AlternarMosaico"
                            ToolTip="Ver todas las pantallas a la vez" />
                    <Button x:Name="BotonCompleta" Style="{StaticResource BotonBarra}"
                            Content="⛶" FontSize="14" Click="AlternarPantallaCompleta"
                            ToolTip="Pantalla completa" />
                </StackPanel>

                <!-- Auto y no Hidden: con veintinueve pestanas la barra se corta
                     y hay que poder ver DONDE estas. Con pocas no aparece, asi
                     que la franja sigue midiendo lo mismo.

                     Y la rueda, que es lo que la hace usable: la del raton es
                     vertical y aqui el scroll vertical esta desactivado, asi que
                     sin el manejador de abajo esto se podia cortar pero no
                     mover. -->
                <ScrollViewer x:Name="TiraPestanas"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="RuedaSobrePestanas">
                    <StackPanel x:Name="Pestanas" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Background="{StaticResource Hueco}">

            <!-- Todas las sesiones viven aqui A LA VEZ, y en modo normal solo una
                 esta visible.

                 NO es un TabControl: el de WPF solo construye el arbol de la
                 pestaña elegida, asi que al cambiar destruiria el HwndHost del
                 video, y con el la cadena de intercambio y el descodificador.
                 Cada cambio de pestaña costaria una reconexion entera.

                 El mosaico lo reparte ParedDeMosaicos, que cuenta los hijos
                 VISIBLES, asi que enseñar una o cuatro sigue siendo cuestion
                 de Visibility y nada mas.

                 Era un UniformGrid y reparte CELDAS, no imagenes: el sobrante
                 de encajar un 16:9 en una celda mas cuadrada salia como bandas
                 negras entre filas, y la celda que sobraba con cinco pantallas
                 quedaba de cuadro negro en una esquina. -->
            <render:ParedDeMosaicos x:Name="Contenido" />

            <TextBlock x:Name="SinSesiones" Foreground="{StaticResource LetraTenue}"
                       FontFamily="Segoe UI" FontSize="13" TextAlignment="Center" LineHeight="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Sin sesiones.&#x0a;&#x0a;Este visor lo abre el dashboard al pulsar CONTROLAR PC." />
        </Grid>
    </DockPanel>
</Window>
