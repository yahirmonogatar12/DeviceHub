<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeviceHub.RemoteViewer</RootNamespace>
    <AssemblyName>DeviceHub.RemoteViewer</AssemblyName>

    <!-- Igual que el dashboard: WPF llama a XmlLanguage.GetSpecificCulture() al
         renderizar y sin datos de cultura muere con "Cannot find non-neutral
         culture related to 'en-us'". Directory.Build.props activa la
         globalizacion invariante para todo el repositorio. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- El icono del ejecutable, y de paso el de las ventanas: WPF usa el del
         .exe cuando la ventana no declara otro. -->
    <ApplicationIcon>..\..\assets\devicehub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Remote.Contracts\DeviceHub.Remote.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>


  <!-- La barra de desplazamiento vive en src\Shared y la comparten el
       dashboard y el visor: es la misma plantilla y una sola copia. -->
  <ItemGroup>
    <Page Include="..\Shared\Barras.xaml">
      <Link>Styles\Barras.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
