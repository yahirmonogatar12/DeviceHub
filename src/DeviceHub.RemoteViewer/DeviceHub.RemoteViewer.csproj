<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeviceHub.RemoteViewer</RootNamespace>
    <AssemblyName>DeviceHub.RemoteViewer</AssemblyName>

    <!-- Igual que el dashboard: WPF llama a XmlLanguage.GetSpecificCulture() al
         renderizar y sin datos de cultura muere con "Cannot find non-neutral
         culture related to 'en-us'". Directory.Build.props activa la
         globalizacion invariante para todo el repositorio. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceHub.Contracts\DeviceHub.Contracts.csproj" />
    <ProjectReference Include="..\DeviceHub.Remote.Contracts\DeviceHub.Remote.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
