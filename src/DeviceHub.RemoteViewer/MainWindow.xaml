<Window x:Class="DeviceHub.RemoteViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceHub - Control remoto" Height="620" Width="1000"
        Background="#0B1F55" WindowStartupLocation="CenterScreen">

    <!-- Esta ventana es solo el aviso de "no hay sesion". El video se pinta en
         PlayerWindow, sobre un HwndHost con swapchain D3D11. -->
    <Grid>
        <TextBlock Foreground="#B6C2DC" FontFamily="Segoe UI" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" LineHeight="22"
                   Text="DeviceHub Remote Viewer&#x0a;&#x0a;Sin sesion. Este visor lo abre el dashboard al pulsar CONTROLAR PC.&#x0a;&#x0a;Diagnostico:  DeviceHub.RemoteViewer --play archivo.h264 [--fps 60] [--loop]" />
    </Grid>
</Window>
