<Window x:Class="DeviceHub.RemoteViewer.RelayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:DeviceHub.RemoteViewer.Render"
        Title="DeviceHub - Sesion remota" Height="700" Width="1180"
        Background="#0B1F55" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Focusable=False en TODOS: si un boton se queda el foco, la barra
             espaciadora lo vuelve a pulsar en vez de viajar a la PC remota. -->
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#16295E" />
            <Setter Property="Foreground" Value="#E8EEFB" />
            <Setter Property="BorderBrush" Value="#2B4488" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- TEXTO OSCURO, y el fondo se deja en paz.
             
             El intento anterior fue al reves: fondo azul oscuro y letra clara.
             Pero la plantilla del ComboBox de Windows NO usa el Background del
             control para pintar ni la caja cerrada ni el popup: los saca de
             sus propios pinceles de tema, que son claros. O sea que el fondo
             seguia blanco y lo unico que se aplicaba era la letra clara: letra
             blanca sobre blanco, y los dos desplegables en blanco.
             
             Se veia hasta en el de la escala, que lleva los textos escritos a
             mano: si "Adaptar" tampoco sale, no faltan datos, falta contraste. -->
        <Style TargetType="ComboBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#0B1F55" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#0B1F55" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D6EE" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2B4488" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- El menu de acciones, por lo mismo. -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#16295E" />
            <Setter Property="Foreground" Value="#E8EEFB" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="#08163D" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BotonCaptura" Content="Captura" Click="Capturar" />
                <Button x:Name="BotonGrabar" Content="Grabar" Click="AlternarGrabacion" />
                <ComboBox x:Name="Escala" SelectionChanged="CambiarEscala" SelectedIndex="0">
                    <ComboBoxItem Content="Adaptar" Tag="0" />
                    <ComboBoxItem Content="Original" Tag="1" />
                    <ComboBoxItem Content="50 %" Tag="0.5" />
                    <ComboBoxItem Content="150 %" Tag="1.5" />
                    <ComboBoxItem Content="200 %" Tag="2" />
                </ComboBox>
                <ComboBox x:Name="Monitores" Width="190" SelectionChanged="CambiarPantalla"
                          DisplayMemberPath="Etiqueta" />
                <Button x:Name="BotonArchivos" Content="Archivos" Click="AlternarArchivos" />
                <Button x:Name="BotonDatos" Content="Datos" Click="AlternarDatos" />

                <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                    <MenuItem Header="Acciones" Foreground="#E8EEFB" Padding="12,4">
                        <MenuItem Header="Ctrl + Alt + Supr" Click="EnviarCtrlAltSupr" />
                        <MenuItem Header="Bloquear la PC remota" Click="BloquearRemota" />
                        <MenuItem x:Name="MenuCongelar" Header="Congelar entrada local"
                                  IsCheckable="True" Click="CongelarEntrada" />
                        <!-- Se puede apagar, y hace falta que se pueda: con esto
                             puesto, Alt+Tab ya no saca al tecnico del visor. -->
                        <MenuItem x:Name="MenuTeclas" Header="Enviar Windows y Alt+Tab a la PC remota"
                                  IsCheckable="True" IsChecked="True" Click="AlternarTeclas" />
                        <Separator />
                        <MenuItem Header="Reiniciar la PC remota..." Click="ReiniciarRemota" />
                    </MenuItem>
                </Menu>

                <TextBlock x:Name="Aviso" VerticalAlignment="Center" FontFamily="Consolas"
                           FontSize="12" Foreground="#8FA6CE" Text="" />
            </StackPanel>
        </Border>

        <!-- Al lado del video, nunca encima: un HwndHost dibuja fuera del arbol
             visual de WPF y cualquier XAML superpuesto quedaria tapado. -->
        <Border x:Name="BarraEstado" DockPanel.Dock="Bottom" Background="#08163D" Padding="12,7">
            <TextBlock x:Name="Estado" FontFamily="Consolas" FontSize="12"
                       Foreground="#B6C2DC" TextWrapping="Wrap"
                       Text="Conectando..." />
        </Border>

        <!-- Al lado del video, nunca encima, por el mismo airspace de siempre. -->
        <Border x:Name="PanelArchivos" DockPanel.Dock="Right" Width="360"
                Background="#08163D" Padding="10" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="&#x2191;" Width="30" Margin="0,0,6,0"
                            Click="SubirCarpeta" ToolTip="Carpeta superior" />
                    <TextBox x:Name="RutaRemota" FontFamily="Consolas" FontSize="12"
                             Background="#061029" Foreground="#E8EEFB" BorderThickness="0"
                             Padding="6,4" KeyDown="RutaEscrita" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ProgressBar x:Name="Progreso" Height="6" Margin="0,0,0,6" />
                    <TextBlock x:Name="EstadoArchivos" FontFamily="Consolas" FontSize="11"
                               Foreground="#8FA6CE" TextWrapping="Wrap" Text="" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Descargar" Click="Descargar" />
                        <Button Content="Subir..." Click="Subir" />
                    </StackPanel>

                    <!-- Portapapeles de archivos. Traer se habilita solo cuando
                         la PC remota anuncia que copiaron algo. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BotonTraer" Content="Traer copiado" Click="Traer"
                                IsEnabled="False" />
                        <Button Content="Llevar copiado" Click="Llevar" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="Archivos" Background="#061029" Foreground="#C8D6EE"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         DisplayMemberPath="Etiqueta" MouseDoubleClick="AbrirEntrada" />
            </DockPanel>
        </Border>

        <!-- ScrollChanged ADEMAS de SizeChanged, y no por gusto: las barras de
             desplazamiento entran y salen solas, y al hacerlo cambian el hueco
             util sin que el ScrollViewer cambie de tamano. SizeChanged no se
             entera de eso; ScrollChanged si. -->
        <ScrollViewer x:Name="Lienzo" Background="#0B1F55" SizeChanged="Ajustar"
                      ScrollChanged="Ajustar"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Un minimo, no un tamano: sin el, el ScrollViewer mide 0x0 y el
                 HWND del video no llega a crearse. El tamano real lo pone
                 Ajustar() en cuanto se conoce la resolucion remota. -->
            <render:VideoSurface x:Name="Video" MinWidth="320" MinHeight="180"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>

    </DockPanel>
</Window>
