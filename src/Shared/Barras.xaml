<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- La barra de desplazamiento, al estilo de Windows 11.

         La de WPF por defecto es la de Windows XP: gris claro, ancha, con dos
         botones de flecha y un canal marcado. Sobre un fondo oscuro se ve como
         una franja blanca pegada al borde, que es justo lo que se reporto.

         Un solo archivo enlazado desde los DOS programas: el dashboard y el
         visor tienen paletas distintas pero el fondo oscuro es el mismo, asi
         que los colores van escritos aqui y no salen del tema de ninguno. Es
         lo que evita mantener dos copias de la misma plantilla.

         Sin botones de flecha a proposito: Windows 11 tampoco los pinta, y cada
         uno son 17 px que en la tira de pestanas del visor se notan. -->

    <SolidColorBrush x:Key="BarraPulgar"        Color="#4A4A4A" />
    <SolidColorBrush x:Key="BarraPulgarEncima"  Color="#5E5E5E" />
    <SolidColorBrush x:Key="BarraPulgarPulsado" Color="#787878" />

    <Style x:Key="PulgarBarra" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- El Border relleno va DENTRO de otro transparente: asi el
                         pulgar se ve delgado pero se agarra en los 10 px enteros.
                         Un pulgar de 6 px es un blanco dificil con el raton. -->
                    <Border Background="Transparent" Padding="3">
                        <Border x:Name="cuerpo" CornerRadius="2"
                                Background="{StaticResource BarraPulgar}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cuerpo" Property="Background"
                                    Value="{StaticResource BarraPulgarEncima}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="cuerpo" Property="Background"
                                    Value="{StaticResource BarraPulgarPulsado}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El canal. Es un RepeatButton de verdad (invisible, pero
         clicable) porque saltar una pagina pulsando encima o debajo del pulgar es
         comportamiento del sistema y quitarlo se nota al usarlo. -->
    <Style x:Key="CanalBarra" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <!-- NO SE LLEVA EL FOCO. Lo pone el estilo del tema, y declarar uno
             implicito lo SUSTITUYE ENTERO: sin repetirlo aqui, la barra se
             volvia enfocable y el teclado se le quedaba dentro. Se noto como
             "dejo de funcionar el copiar y pegar": con el foco en una barra,
             Ctrl+C y Ctrl+V no llegan a la sesion remota. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource CanalBarra}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PulgarBarra}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource CanalBarra}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- La horizontal es la misma plantilla girada: alto en
                             vez de ancho, y el Track deja de ir al reves porque
                             en horizontal el origen ya esta a la izquierda. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- El ScrollViewer, solo por la ESQUINA.

         Donde se cruzan las dos barras, la plantilla de fabrica pinta un
         rectangulo con el color de control del sistema: un cuadro blanco en una
         esquina oscura. No hay forma de quitarlo sin rehacer la plantilla, asi
         que se rehace: son cuatro celdas y ninguna logica. -->
    <Style TargetType="ScrollViewer">
        <!-- Igual que la barra, y por lo mismo. Este es ademas el que sostiene
             el PART_ContentHost de un TextBox: enfocable ahi significa que el
             TextBox no recibe teclas. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                        <!-- La esquina: nada. Aqui estaba el cuadro blanco. -->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
